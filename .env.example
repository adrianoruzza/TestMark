# TestMark — Variabili d'ambiente di esempio (SOLO CONFIGURAZIONE DI BUILD, ZERO SEGRETI)
# TestMark è un'applicazione 100% locale (client-side) e non utilizza alcuna API Key,
# nessun servizio cloud, nessun account esterno né autenticazione OAuth.
#
# Non inserire MAI credenziali, chiavi API, token o dati personali nel repository o in file .env*.

# Base path per pubblicazione GitHub Pages (default automatico in build: /TestMark/)
VITE_BASE_PATH="/TestMark/"
